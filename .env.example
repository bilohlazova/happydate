OPENAI_API_KEY=
HAPPY_LEARNING_TOKEN_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase public client configuration. Prefer the publishable key. The legacy
# anon key is supported only as a temporary compatibility fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value through a NEXT_PUBLIC variable.
SUPABASE_SERVICE_ROLE_KEY=
