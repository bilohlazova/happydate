{
  "name": "toto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run eval:assistant",
    "smoke:production": "node scripts/smoke-production.mjs",
    "eval:assistant": "node --experimental-strip-types scripts/evaluate-assistant.mjs",
    "eval:assistant:live": "RUN_LIVE_ASSISTANT_EVALS=1 node --experimental-strip-types scripts/evaluate-assistant.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "8.2.2",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/push-notifications": "8.1.2",
    "@supabase/supabase-js": "2.112.0",
    "canvas-confetti": "1.9.4",
    "date-fns": "4.4.0",
    "lucide-react": "^0.544.0",
    "next": "16.3.0",
    "next-intl": "4.13.5",
    "openai": "6.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "replicate": "1.4.0",
    "resend": "6.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "baseline-browser-mapping": "^2.10.43",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "uuid": "11.1.1"
  }
}
